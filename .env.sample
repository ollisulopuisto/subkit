# Provider: gemini | openai
SUBKIT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# thinkingLevel is a Gemini 3.x parameter; set to "off" for other models
GEMINI_THINKING_LEVEL=low
# OpenAI-compatible endpoint (llama-swap, Ollama, OpenRouter, ...)
# OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gemma4

# Translation
TARGET_LANGUAGE=Finnish
SOURCE_LANGUAGE=            # empty = auto-detect per file
# GLOSSARY_PATH=series-glossary.json          # static terms, win over auto-extracted
# ROLLING_GLOSSARY_SAVE=series-glossary.json  # save auto-extracted terms here
# FULL_CONTEXT=on       # send whole original transcript as read-only context

# Reliability / cost control
# MAX_RETRIES=3
# RETRY_BASE_DELAY=1.5
# REQUEST_DELAY=0       # seconds between provider calls
# MAX_REQUESTS=0        # hard cap on provider calls per run; 0 = unlimited
# RESUME_MODE=auto      # auto resumes from <input>.subkit-status.json
# CPS=25
# CHUNK_MAX_LINES=18
# LOG_LEVEL=INFO
